@model Spot
<h1>@(Model.Id == 0 ? "Добави място" : "Редактирай място")</h1>
<form asp-action="Save" method="post" class="formbox">
  <div asp-validation-summary="All" class="error"></div>
  <input asp-for="Id" type="hidden" />
  <label>Име<input asp-for="Name" required /></label>
  <label>Адрес<input asp-for="Address" required /></label>
  <label>Град<input asp-for="City" required /></label>
  <label>Категория<select asp-for="Category"><option>Библиотека</option><option>Кафене</option><option>Coworking</option></select></label>
  <label>Описание<textarea asp-for="Description"></textarea></label>
  <label>Официален сайт<input asp-for="Website" type="url" /></label>
  <label>Работно време<input asp-for="OpeningHours" /></label>
  <label>Ширина<input asp-for="Latitude" type="number" step="any" /></label>
  <label>Дължина<input asp-for="Longitude" type="number" step="any" /></label>
  <label>Цена на час (лв.)<input asp-for="PricePerHour" type="number" min="0" /></label>
  <div class="checks">
    <label><input asp-for="Wifi" /> Wi-Fi</label>
    <label><input asp-for="Outlets" /> Контакти</label>
    <label><input asp-for="Quiet" /> Тихо</label>
    <label><input asp-for="IsVerified" /> Данните са проверени</label>
  </div>
  <button class="btn" type="submit">Запази</button>
</form>
