@model Spot
<h1>@(Model.Id==0?"Добавяне на място":"Редакция на място")</h1><form asp-action="Save" method="post" class="formbox"><div asp-validation-summary="All" class="error"></div><input asp-for="Id" type="hidden"/><label>Име<input asp-for="Name" /></label><label>Адрес<input asp-for="Address" /></label><label>Град<input asp-for="City" /></label><label>Категория<input asp-for="Category" /></label><label>Описание<input asp-for="Description" /></label><label>Работно време<input asp-for="OpeningHours" /></label><label>Географска ширина<input asp-for="Latitude" type="number" step="any"/></label><label>Географска дължина<input asp-for="Longitude" type="number" step="any"/></label><label>Цена на час (лв.)<input asp-for="PricePerHour" type="number" min="0"/></label><label><input asp-for="Wifi"/> Wi-Fi</label><label><input asp-for="Outlets"/> Контакти</label><label><input asp-for="Quiet"/> Тихо</label><button class="btn">Запази</button></form>