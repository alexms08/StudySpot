@model Spot
@using System.Security.Claims
@{
    var average = Model.Reviews.Any() ? Model.Reviews.Average(r => r.Rating).ToString("0.0") : "Няма оценки";
    var uid = User.FindFirstValue(ClaimTypes.NameIdentifier);
}
<a class="backlink" asp-action="Index">← Всички места</a>
<section class="detail">
  <div>
    <span class="chip">@Model.Category</span>
    @if (Model.IsVerified) { <span class="verified">✓ Проверено от администратор</span> }
    <h1>@Model.Name</h1>
    <p>📍 @Model.City, @Model.Address</p>
    <p>@Model.Description</p>
    <div class="tags">
      <span>📶 Wi-Fi: @(Model.Wifi ? "Да" : "Няма информация")</span>
      <span>🔌 Контакти: @(Model.Outlets ? "Да" : "Няма информация")</span>
      <span>🤫 Тихо: @(Model.Quiet ? "Да" : "Няма информация")</span>
    </div>
    <p><b>Работно време:</b> @(string.IsNullOrWhiteSpace(Model.OpeningHours) ? "Проверете преди посещение" : Model.OpeningHours)</p>
    <p><b>Цена:</b> @(Model.PricePerHour == 0 ? "Не е посочена" : $"{Model.PricePerHour} лв./час")</p>
    <p><b>Средна оценка:</b> ⭐ @average</p>
    @if (!string.IsNullOrWhiteSpace(Model.Website))
    {
      <p><a href="@Model.Website" target="_blank" rel="noopener noreferrer">Официална страница ↗</a></p>
    }
    @if (User.Identity?.IsAuthenticated == true)
    {
      <form asp-controller="Favorites" asp-action="Toggle" method="post">
        <input type="hidden" name="spotId" value="@Model.Id" />
        <button type="submit" class="btn">♡ Добави / премахни от любими</button>
      </form>
    }
  </div>
  <div class="map">
    @if (Model.Latitude != 0 && Model.Longitude != 0)
    {
      <iframe title="Карта на местоположението" loading="lazy" referrerpolicy="no-referrer-when-downgrade"
        src="https://www.openstreetmap.org/export/embed.html?bbox=@(Model.Longitude-0.01)%2C@(Model.Latitude-0.008)%2C@(Model.Longitude+0.01)%2C@(Model.Latitude+0.008)&amp;layer=mapnik&amp;marker=@Model.Latitude%2C@Model.Longitude"></iframe>
      <a target="_blank" rel="noopener noreferrer" href="https://www.openstreetmap.org/?mlat=@Model.Latitude&amp;mlon=@Model.Longitude#map=16/@Model.Latitude/@Model.Longitude">Отвори картата ↗</a>
      <small>Карта © OpenStreetMap contributors</small>
    }
    else { <div class="empty">Точно местоположение все още не е посочено.</div> }
  </div>
</section>
<div class="sectiontitle"><h2>Отзиви (@Model.Reviews.Count)</h2></div>
@if (TempData["Error"] is string error) { <p class="error" role="alert">@error</p> }
@foreach (var review in Model.Reviews.OrderByDescending(x => x.CreatedAt))
{
  <div class="review">
    <b>@review.User.UserName</b> · ⭐ @review.Rating/5
    <p>@review.Comment</p>
    <small>@review.CreatedAt.ToString("dd.MM.yyyy")</small>
    @if (review.UserId == uid || User.IsInRole("Admin"))
    {
      <form asp-controller="Reviews" asp-action="Delete" method="post">
        <input type="hidden" name="id" value="@review.Id" />
        <button type="submit" class="linkbtn danger">Изтрий отзива</button>
      </form>
    }
  </div>
}
@if (User.Identity?.IsAuthenticated == true)
{
  <form class="formbox" asp-controller="Reviews" asp-action="Add" method="post">
    <h3>Остави оценка</h3>
    <input type="hidden" name="spotId" value="@Model.Id" />
    <label>Оценка<select name="rating">@for (var i = 5; i >= 1; i--) { <option value="@i">@i звезди</option> }</select></label>
    <label>Коментар<textarea name="comment" maxlength="500" required></textarea></label>
    <button class="btn" type="submit">Публикувай</button>
  </form>
}
else { <p><a asp-controller="Account" asp-action="Login">Влез</a>, за да оставиш отзив.</p> }
