@model Spot
@{var avg=Model.Reviews.Any()?Model.Reviews.Average(r=>r.Rating).ToString("0.0"):"Няма оценки";}
<a asp-action="Index">← Всички места</a><section class="detail"><div><span class="chip">@Model.Category</span><h1>@Model.Name</h1><p>📍 @Model.City, @Model.Address</p><p>@Model.Description</p><div class="tags"><span>📶 Wi-Fi: @(Model.Wifi?"Да":"Не")</span><span>🔌 Контакти: @(Model.Outlets?"Да":"Не")</span><span>🤫 Тихо: @(Model.Quiet?"Да":"Не")</span></div><p><b>Работно време:</b> @Model.OpeningHours</p><p><b>Цена:</b> @(Model.PricePerHour==0?"Без такса":$"{Model.PricePerHour} лв./час")</p><p><b>Оценка:</b> ⭐ @avg</p>@if(User.Identity?.IsAuthenticated==true){<form asp-controller="Favorites" asp-action="Toggle" method="post"><input type="hidden" name="spotId" value="@Model.Id"/><button class="btn">♡ Добави / премахни от любими</button></form>}</div><div class="map"><iframe title="Карта" loading="lazy" referrerpolicy="no-referrer-when-downgrade" src="https://www.openstreetmap.org/export/embed.html?bbox=@(Model.Longitude-0.01)%2C@(Model.Latitude-0.008)%2C@(Model.Longitude+0.01)%2C@(Model.Latitude+0.008)&layer=mapnik&marker=@Model.Latitude%2C@Model.Longitude"></iframe><a target="_blank" rel="noopener noreferrer" href="https://www.openstreetmap.org/?mlat=@Model.Latitude&mlon=@Model.Longitude#map=16/@Model.Latitude/@Model.Longitude">Отвори картата ↗</a></div></section>
<h2>Отзиви (@Model.Reviews.Count)</h2>@if(TempData["Error"]!=null){<p class="error">@TempData["Error"]</p>}@foreach(var r in Model.Reviews.OrderByDescending(x=>x.CreatedAt)){<div class="review"><b>@r.User.UserName</b> · ⭐ @r.Rating/5<p>@r.Comment</p></div>}@if(User.Identity?.IsAuthenticated==true){<form class="formbox" asp-controller="Reviews" asp-action="Add" method="post"><h3>Остави оценка</h3><input type="hidden" name="spotId" value="@Model.Id"/><label>Оценка <select name="rating">@for(int i=5;i>=1;i--){<option value="@i">@i звезди</option>}</select></label><label>Коментар <textarea name="comment" maxlength="500" required></textarea></label><button class="btn">Публикувай</button></form>}else{<p><a asp-controller="Account" asp-action="Login">Влез</a>, за да напишеш отзив.</p>}