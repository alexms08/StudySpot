@model List<Spot>
<section class="hero"><span class="eyebrow">Твоето пространство за концентрация</span><h1>Намери идеалното място <em>за учене.</em></h1><p>Библиотеки, кафенета и coworking пространства — на едно място.</p></section>
<form method="get" class="filters"><input name="q" placeholder="Търси по име или адрес..." value="@Context.Request.Query["q"]"/><input name="city" placeholder="Град" value="@Context.Request.Query["city"]"/><select name="category"><option value="">Всички категории</option>@foreach(var cat in new[]{"Библиотека","Кафене","Coworking"}){<option value="@cat" selected="@(Context.Request.Query["category"]==cat)">@cat</option>}</select><label><input type="checkbox" name="wifi" value="true" checked="@(Context.Request.Query["wifi"]=="true")"/> Wi-Fi</label><label><input type="checkbox" name="outlets" value="true" checked="@(Context.Request.Query["outlets"]=="true")"/> Контакти</label><label><input type="checkbox" name="quiet" value="true" checked="@(Context.Request.Query["quiet"]=="true")"/> Тихо</label><button class="btn">Търси</button></form>
<div class="sectiontitle"><h2>Открий места</h2><span>@Model.Count резултата</span></div><div class="cards">@foreach(var spot in Model){<article class="spot"><div class="spotart">@(spot.Category=="Кафене"?"☕":spot.Category=="Coworking"?"💻":"📖")</div><div class="spotbody"><span class="chip">@spot.Category</span><h3>@spot.Name</h3><p>📍 @spot.City · @spot.Address</p><div class="tags">@if(spot.Wifi){<span>📶 Wi-Fi</span>}@if(spot.Outlets){<span>🔌 Контакти</span>}@if(spot.Quiet){<span>🤫 Тихо</span>}</div><div class="spotfoot"><strong>@(spot.PricePerHour==0?"Без такса":$"{spot.PricePerHour} лв./час")</strong><a class="btn small" asp-action="Details" asp-route-id="@spot.Id">Виж повече</a></div></div></article>}</div>@if(!Model.Any()){<p>Няма намерени места. Опитай с други филтри.</p>}