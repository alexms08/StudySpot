<!DOCTYPE html><html lang="bg"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>StudySpot – Намери място за учене</title><link rel="stylesheet" href="~/css/site.css"/></head><body><header><nav class="nav container"><a class="brand" asp-controller="Home" asp-action="Index">📚 StudySpot</a><div class="links"><a asp-controller="Home" asp-action="Index">Места</a>@if(User.Identity?.IsAuthenticated==true){<a asp-controller="Favorites" asp-action="Index">Любими</a>@if(User.IsInRole("Admin")){<a asp-controller="Admin" asp-action="Index">Админ</a>}<form asp-controller="Account" asp-action="Logout" method="post"><button class="linkbtn">Изход</button></form>}else{<a asp-controller="Account" asp-action="Login">Вход</a><a class="btn small" asp-controller="Account" asp-action="Register">Регистрация</a>}</div></nav></header><main class="container">@RenderBody()</main><footer class="container">StudySpot · Дипломен проект · Демонстрационни данни</footer></body></html>